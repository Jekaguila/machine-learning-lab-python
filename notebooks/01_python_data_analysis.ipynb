# Python for Data Analysis

import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt

# Load dataset
data = sns.load_dataset("tips")

print(data.head())

# Summary statistics
print(data.describe())

# Visualization
sns.scatterplot(data=data, x="total_bill", y="tip")

plt.title("Relationship between bill and tip")
plt.show()
